pub tangible category Category:Puck

const PUCK_RESTITUTION = 0.8
const PUCK_FRICTION = 0.9
const PUCK_RADIUS = 4.5

pub fn puck.Puck {
    use body = puck
    use layer = 3
    
    Body(pos=@(0, 0), gravityScale=0, bullet=true)
    PolygonCollider(shape=Circle(radius=PUCK_RADIUS), category=Category:Puck, density=2, restitution=PUCK_RESTITUTION, friction=PUCK_FRICTION, intercept=Category:Mallet)
    PolygonSprite(shape=Circle(radius=PUCK_RADIUS), color=#ffffff, layer=layer)
    
}
