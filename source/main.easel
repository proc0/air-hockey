pub game fn World.Main() {
    SolidBackground(color=#222222)
    Camera(@(0,0), radius=@(50,50))
    Viewport(aspectRatio=1.6)
    
    let t = Spawn table {
        Table


    }

    let p = Spawn puck {
        Puck 
    }
    
    on GoalTop, GoalBottom, GoalLeft, GoalRight {
        p = Spawn puck {
            Puck
        }
    }
    
    SpawnBot
    SpawnEachPlayer player {
        const playerSide = player.IsHuman ? t.Side<TableSideNear> : t.Side<TableSideFar>
        const playerStartPos = player.IsHuman ? t.StartPos<TableSideNear> : t.StartPos<TableSideFar>
        
        const m = Subspawn mallet {
            Mallet(side=playerSide, pos=playerStartPos)
        }

        if player.IsHuman {           
            Subspawn hand {
                Hand
            }

            on MalletGrabAttempt {
                if !t.PointerOutside(m.Owner) && !t.WrongSide(m.Owner, mallet=m) {
                    GrabMallet
                }
            }
        }

        if !player.IsHuman {
            on Tick(3) {
                const ownGoalPos = @(playerSide.X, 0)
                const puckLine = ownGoalPos - p.Pos
                const malletLine = m.Pos - p.Pos
                const malletPuckDot = Dot(puckLine.Direction, malletLine.Direction)
                const malletLineProject = (Dot(puckLine, malletLine)/Length(puckLine).Pow(2))*puckLine
                const malletDestination = p.Pos+malletLineProject-m.Pos

                // on Paint {
                //     PolygonSprite(body=p, shape=Line([@(0,0), malletLine], radius=0.3), color=#ff0000, layer=10)
                //     PolygonSprite(body=p, shape=Line([@(0,0), puckLine], radius=0.2), color=#000000, layer=11)
                //     PolygonSprite(body=m, shape=Line([@(0,0), malletDestination], radius=0.3), color=#00ff00, layer=12)
                // }
                
                if (Length(m.Pos) > Length(playerStartPos)*1.3) {
                    m.Velocity = m.Velocity.Towards((playerStartPos-m.Pos)*3, 50)
                    
                }
                else if (malletPuckDot < 0.99) {
                    m.Velocity = m.Velocity.Towards(malletDestination*3, 50)
                } 
                else {
                    m.Velocity = @(0,0)
                }
            }
    
            on m.BeforeCollide that {
                if that.Category.Overlaps(Category:Puck) {
                    const impulseDirection = playerSide.X > 0 ? -1 : 1
                    m.ApplyImpulse(@(impulseDirection*10000, 0))
                }
            }
        }

    }


}