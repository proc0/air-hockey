pub game fn World.Main() {
    SolidBackground(color=#222222)
    Camera(@(0,0), radius=@(50,50))
    Viewport(aspectRatio=1.6)
    
    Spawn table {
        Table

        on GoalTop, GoalBottom, GoalLeft, GoalRight {
            Spawn puck {
                Puck
            }
        }
    }
    
    SpawnEachPlayer owner {
        Subspawn mallet {
            Mallet
        }
        
        Subspawn hand {
            Hand
        }
    }

    Spawn puck {
        Puck 
    }

}