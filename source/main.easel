pub game fn World.Main() {
    Spawn table {
        Table

        on GoalLeft {
            Spawn puck {
                Puck
            }
        }

        on GoalRight {
            Spawn puck {
                Puck
            }
        }
    }
    
    SpawnEachPlayer owner {
        Subspawn mallet {
            Mallet
        }
        
        Subspawn hand {
            Hand
        }
    }

    Spawn puck {
        Puck 
    }

}