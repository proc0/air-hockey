pub tangible category Category:Puck

const PUCK_RESTITUTION = 0.8
const PUCK_FRICTION = 0
const PUCK_RADIUS = 4

pub fn puck.Puck(pos=@(0,0)) {
    use body = puck
    use layer = 4
    use pos=pos
    
    Body(pos=@(0, 0), gravityScale=0)
    PolygonCollider(shape=Circle(radius=PUCK_RADIUS), category=Category:Puck, density=1, restitution=PUCK_RESTITUTION, friction=PUCK_FRICTION, intercept=true, tolerance=0.1)
    PolygonSprite(shape=Circle(radius=PUCK_RADIUS), color=#555555, layer=layer)
    PolygonSprite(shape=Circle(radius=PUCK_RADIUS-0.5), color=#000000, layer=layer)
    // PolygonSprite(shape=Line([@(0,-PUCK_RADIUS), @(0, PUCK_RADIUS)], radius=0.5), color=#222222, layer=layer+1)
    PolygonSprite(shape=Rhombus(width=PUCK_RADIUS, height=PUCK_RADIUS*0.6), color=#555555, layer=layer+1)
    // PolygonSprite(shape=Rhombus(width=PUCK_RADIUS*0.65, height=PUCK_RADIUS*0.3), color=#000000, layer=layer+1)
    PolygonSprite(shape=Circle(radius=PUCK_RADIUS*0.2), color=#000000, layer=layer+1)
    
    DecaySpeed(0.018)
    DecayTurnRate(0.08)
    LimitSpeed(300)
    
    on Paint {
        Streak(dissipate=0.2s, bloom=0.6, diminish=0.9, taper=0.8, fade=0.8, opacity=0.5, radius=3, ownerColor=0, bloomAlpha=0.2, glare=0.3, color=#bbbbbb, layer=layer-1)
    }

    // Curve ball
    // ----------
    let collideState = 0
    const frameDuration = TicksPerSecond/60
    const collideDecayDuration = 0.5*frameDuration
    const collideDecayRate = 0.005
    let collideTargetRate = 0
    let collideTargetDirection = @(0, 0)
    on BeforeCollide that {
        if (collideState <= 0 && that.Category.Overlaps(Category:Mallet) && Length(that.Velocity) > 100) {
            collideState = collideDecayDuration
            // collideTargetRate = Abs(1-Dot(Velocity.Direction, that.Velocity.Direction))*0.5
            let collideDirection = Dot(Velocity.Direction, that.Velocity.Direction)
            collideTargetRate = Abs(collideDirection) < 0.5 ? (1-Abs(collideDirection)).Clamp(0,1)*0.5 : 0
            collideTargetDirection = (that.Velocity*-1 + Velocity)/2
            ConsoleLog(collideTargetRate)
        }
    }

    on BeforePhysics {
        if (collideState > 0) {
            collideState -= collideDecayRate
            Velocity = Velocity.Towards(collideTargetDirection, collideTargetRate*2)
            ApplyTurningImpulse(collideTargetRate*500)
        }
    }

}
