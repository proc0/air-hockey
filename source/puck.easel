pub tangible category Category:Puck

const PUCK_RESTITUTION = 0.8
const PUCK_FRICTION = 0
const PUCK_RADIUS = 4

pub fn puck.Puck {
    use body = puck
    use layer = 3
    
    Body(pos=@(0, 0), gravityScale=0)
    PolygonCollider(shape=Circle(radius=PUCK_RADIUS), category=Category:Puck, density=1, restitution=PUCK_RESTITUTION, friction=PUCK_FRICTION, intercept=true, tolerance=0.1)
    PolygonSprite(shape=Circle(radius=PUCK_RADIUS), color=#ffffff, layer=layer)
    PolygonSprite(shape=Line([@(0,-PUCK_RADIUS), @(0, PUCK_RADIUS)], radius=0.5), color=#222222, layer=layer+1)
    
    DecaySpeed(0.015)
    DecayTurnRate(0.08)

    let collisionVector = @(0,0)

    once BeforeCollide that {
        if that.Category.Overlaps(Category:Mallet) {
            // let turnAmount = Dot(Velocity.Direction, that.Velocity)*Length(that.Velocity)
            collisionVector = that.Velocity
        }
    }
    
    on BeforeCollide that {
        if that.Category.Overlaps(Category:Mallet) {
            let turnAmount = Dot(Velocity.Direction, that.Velocity)*Length(that.Velocity)
            ApplyTurningImpulse(Abs(1-turnAmount))
        }
    }

    on BeforePhysics {
        if (Abs(collisionVector.X) > 0.2 || Abs(collisionVector.Y) > 0.2) {
            Velocity += collisionVector
            collisionVector *= 0.01
        }
    }
}
