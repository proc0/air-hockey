pub tangible category Category:Puck

const PUCK_RADIUS = 4
const PUCK_COLOR = #000000
const PUCK_RESTITUTION = 0.8
const PUCK_FRICTION = 0

pub fn puck.Puck(radius=PUCK_RADIUS, color=PUCK_COLOR, pos=@(0,0)) {
    use body = puck
    use radius=radius
    use color=color
    use pos=pos
    use layer = 4
    
    Body(pos=@(0, 0), gravityScale=0)
    PolygonCollider(shape=Circle, category=Category:Puck, density=1, restitution=PUCK_RESTITUTION, friction=PUCK_FRICTION, intercept=true, tolerance=0.1)
    
    PolygonSprite(shape=Circle, color=color.Lighten(0.3), layer=layer)
    PolygonSprite(shape=Circle(radius=radius-0.5), layer=layer)
    
    PolygonSprite(shape=Rhombus(width=radius, height=radius*0.6), color=color.Lighten(0.3), layer=layer+1)
    PolygonSprite(shape=Circle(radius=radius*0.2), layer=layer+1)
    
    DecaySpeed(0.018)
    DecayTurnRate(0.08)
    LimitSpeed(300)
    
    on Paint {
        Streak(dissipate=0.2s, bloom=0.6, diminish=0.9, taper=0.8, fade=0.8, opacity=0.5, radius=3, ownerColor=0, bloomAlpha=0.2, glare=0.3, color=#bbbbbb, layer=layer-1)
    }

    
    // Curve ball
    // ----------
    let collideState = 0
    const frameDuration = TicksPerSecond/60
    const collideDecayDuration = 0.5*frameDuration
    const collideDecayRate = 0.005
    let collideTargetRate = 0
    let collideTargetDirection = @(0, 0)
    on BeforeCollide that {
        if (collideState <= 0 && that.Category.Overlaps(Category:Mallet) && Length(that.Velocity) > 100) {
            collideState = collideDecayDuration
            let collideDirection = Dot(Velocity.Direction, that.Velocity.Direction)
            const CURVE_DAMP = 0.7
            const CURVE_CLAMP = 0.4
            collideTargetRate = Abs(collideDirection) < CURVE_CLAMP ? (1-Abs(collideDirection)).Clamp(0,1)*CURVE_DAMP : 0
            collideTargetDirection = (that.Velocity*-1 + Velocity)/2
            ConsoleLog(collideTargetRate)
        }
    }

    on BeforePhysics {
        if (collideState > 0) {
            collideState -= collideDecayRate
            Velocity = Velocity.Towards(collideTargetDirection, collideTargetRate*2)
            ApplyTurningImpulse(collideTargetRate*500)
        }
    }

}

