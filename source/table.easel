pub tangible category Category:Table

const TABLE_SIZE = @(130, 70)
const TABLE_ORIGIN = @(0, 0)
const TABLE_GOAL_WIDTH = 0.35
const TABLE_GOAL_DEPTH = 5
const TABLE_BORDER_WIDTH = 2
const TABLE_CORNER_WIDTH = 1
const TABLE_CORNER_CURVE = 7
const TABLE_RESTITUTION = 0.95

const TABLE_COLOR_SURFACE = #dddddd
const TABLE_COLOR_GOAL = #87ee89
const TABLE_COLOR_BORDER = #111111
const TABLE_COLOR_LINE = #888888

pub symbol TableOrientationLandscape
pub symbol TableOrientationPortrait
pub symbol TableSideFar
pub symbol TableSideNear

pub prop table.Side<SideId>
pub prop table.StartPos<SideId>
pub prop table.Size
pub prop table.Orientation

pub signal World.ReleaseMallet
pub signal World.GrabMallet
pub signal World.GoalTop
pub signal World.GoalBottom
pub signal World.GoalLeft
pub signal World.GoalRight

prop table.GoalTopRect
prop table.GoalBottomRect
prop table.GoalLeftRect
prop table.GoalRightRect
// table parts
// -----------
// top corners
symbol TableCornerTopLeft
symbol TableCornerTopRight

// top
symbol TableBorderTop
symbol TableBorderTopLeft
symbol TableGoalTop
symbol TableBorderTopRight
// bottom
symbol TableBorderBottom
symbol TableBorderBottomLeft
symbol TableGoalBottom
symbol TableBorderBottomRight

// bottom corners
symbol TableCornerBottomLeft
symbol TableCornerBottomRight

// left
symbol TableBorderLeft
symbol TableBorderLeftTop
symbol TableGoalLeft
symbol TableBorderLeftBottom
// right
symbol TableBorderRight
symbol TableBorderRightTop
symbol TableGoalRight
symbol TableBorderRightBottom

symbol TableMiddleSeparator

pub fn table.Table(tableSize=TABLE_SIZE) {
    use body = table
    use layer = 2

    Size=tableSize
    
    Body(pos=TABLE_ORIGIN, immovable=true)

    let tableOrientation = tableSize.X > tableSize.Y ? TableOrientationLandscape : TableOrientationPortrait

    Orientation = tableOrientation
    
    let goalSize = @(TABLE_GOAL_DEPTH, tableSize.Y*TABLE_GOAL_WIDTH)
    let goalSideLength = 0.5*tableSize.Y*(1 - TABLE_GOAL_WIDTH)
    let goalSensorOffset = TABLE_BORDER_WIDTH*2
    StartPos<TableSideNear> = @(-tableSize.X*0.3, 0)
    StartPos<TableSideFar> = @(tableSize.X*0.3, 0)
    
    if (tableOrientation == TableOrientationPortrait) {
        goalSize = @(tableSize.X*TABLE_GOAL_WIDTH, TABLE_GOAL_DEPTH)
        goalSideLength = 0.5*tableSize.X*(1 - TABLE_GOAL_WIDTH)
        StartPos<TableSideNear> = @(0, tableSize.X*0.6)
        StartPos<TableSideFar> = @(0, -tableSize.X*0.6)
    }
    
    Side<TableSideNear> = @(-tableSize.X*0.5, tableSize.Y*0.5)
    Side<TableSideFar> = @(tableSize.X*0.5, -tableSize.Y*0.5)
    
    // Table Border Collision Shapes
    // -----------------------------
    // top corners
    const cornerTopLeft = Arc(arc=0.25rev, orbit=TABLE_CORNER_CURVE, pos=@(-tableSize.X*0.5+(2*TABLE_CORNER_CURVE-TABLE_CORNER_WIDTH), -tableSize.Y*0.5+TABLE_CORNER_CURVE-TABLE_CORNER_WIDTH), radius=TABLE_CORNER_WIDTH, angle=0.5rev)
    const cornerTopRight = Arc(arc=0.25rev, orbit=TABLE_CORNER_CURVE, pos=@(tableSize.X*0.5+TABLE_CORNER_WIDTH, -tableSize.Y*0.5+TABLE_CORNER_CURVE-TABLE_CORNER_WIDTH), radius=TABLE_CORNER_WIDTH, angle=0.75rev)

    // top
    const rectTop = Rectangle(pos=@(0, -tableSize.Y*0.5-TABLE_BORDER_WIDTH*0.5), width=tableSize.X, height=TABLE_BORDER_WIDTH)
    const rectTopLeft = Rectangle(pos=@(-(goalSize.X+goalSideLength)*0.5, -tableSize.Y*0.5-TABLE_BORDER_WIDTH*0.5), width=goalSideLength, height=TABLE_BORDER_WIDTH)
    const rectGoalTop = Rectangle(pos=@(0, -tableSize.Y*0.5-goalSensorOffset), width=goalSize.X, height=goalSize.Y)
    const rectTopRight = Rectangle(pos=@((goalSize.X+goalSideLength)*0.5, -tableSize.Y*0.5-TABLE_BORDER_WIDTH*0.5), width=goalSideLength, height=TABLE_BORDER_WIDTH)
    
    // bottom
    const rectBottom = Rectangle(pos=@(0, tableSize.Y*0.5+TABLE_BORDER_WIDTH*0.5), width=tableSize.X, height=TABLE_BORDER_WIDTH)
    const rectBottomLeft = Rectangle(pos=@(-(goalSize.X+goalSideLength)*0.5, tableSize.Y*0.5+TABLE_BORDER_WIDTH*0.5), width=goalSideLength, height=TABLE_BORDER_WIDTH)
    const rectGoalBottom = Rectangle(pos=@(0, tableSize.Y*0.5+goalSensorOffset), width=goalSize.X, height=goalSize.Y)
    const rectBottomRight = Rectangle(pos=@((goalSize.X+goalSideLength)*0.5, tableSize.Y*0.5+TABLE_BORDER_WIDTH*0.5), width=goalSideLength, height=TABLE_BORDER_WIDTH)    
    
    // bottom corners
    const cornerBottomLeft = Arc(arc=0.25rev, orbit=TABLE_CORNER_CURVE, pos=@(-tableSize.X*0.5+(2*TABLE_CORNER_CURVE-TABLE_CORNER_WIDTH), tableSize.Y*0.5-TABLE_CORNER_CURVE+TABLE_CORNER_WIDTH), radius=TABLE_CORNER_WIDTH, angle=0.25rev)
    const cornerBottomRight = Arc(arc=0.25rev, orbit=TABLE_CORNER_CURVE, pos=@(tableSize.X*0.5+TABLE_CORNER_WIDTH, tableSize.Y*0.5-TABLE_CORNER_CURVE+TABLE_CORNER_WIDTH), radius=TABLE_CORNER_WIDTH, angle=0rev)
    
    // left
    const rectLeft = Rectangle(pos=@(-tableSize.X*0.5-TABLE_BORDER_WIDTH*0.5, 0), width=TABLE_BORDER_WIDTH, height=tableSize.Y)
    const rectLeftTop = Rectangle(pos=@(-tableSize.X*0.5-TABLE_BORDER_WIDTH*0.5, -(goalSize.Y+goalSideLength)*0.5), width=TABLE_BORDER_WIDTH, height=goalSideLength)
    const rectGoalLeft = Rectangle(pos=@(-tableSize.X*0.5-goalSensorOffset, 0), width=goalSize.X, height=goalSize.Y)
    const rectLeftBottom = Rectangle(pos=@(-tableSize.X*0.5-TABLE_BORDER_WIDTH*0.5, (goalSize.Y+goalSideLength)*0.5), width=TABLE_BORDER_WIDTH, height=goalSideLength)
    // right
    const rectRight = Rectangle(pos=@(tableSize.X*0.5+TABLE_BORDER_WIDTH*0.5, 0), width=TABLE_BORDER_WIDTH, height=tableSize.Y)
    const rectRightTop = Rectangle(pos=@(tableSize.X*0.5+TABLE_BORDER_WIDTH*0.5, -(goalSize.Y+goalSideLength)*0.5), width=TABLE_BORDER_WIDTH, height=goalSideLength)
    const rectGoalRight = Rectangle(pos=@(tableSize.X*0.5+goalSensorOffset, 0), width=goalSize.X, height=goalSize.Y)
    const rectRightBottom = Rectangle(pos=@(tableSize.X*0.5+TABLE_BORDER_WIDTH*0.5, (goalSize.Y+goalSideLength)*0.5), width=TABLE_BORDER_WIDTH, height=goalSideLength)

    // Table Collision
    // ---------------
    PolygonCollider<TableCornerTopLeft>(shape=cornerTopLeft, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=cornerTopLeft, color=#00ff00)
    PolygonCollider<TableCornerTopRight>(shape=cornerTopRight, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=cornerTopRight, color=#00ff00)

    if tableOrientation == TableOrientationPortrait {
        PolygonCollider<TableBorderTopLeft>(shape=rectTopLeft, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectTopLeft, color=#00ff00, layer=layer)
        PolygonCollider<TableGoalTop>(shape=rectGoalTop, isSensor=true, category=Category:Table, collideWith=Category:Puck, sense=Category:Puck)
        // PolygonSprite(shape=rectGoalTop, color=#00ff00, layer=layer+3)
        PolygonCollider<TableBorderTopRight>(shape=rectTopRight, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectTopRight, color=#00ff00, layer=layer)

        PolygonCollider<TableBorderBottomLeft>(shape=rectBottomLeft, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectBottomLeft, color=#00ff00, layer=layer)
        PolygonCollider<TableGoalBottom>(shape=rectGoalBottom, isSensor=true, category=Category:Table, collideWith=Category:Puck, sense=Category:Puck)
        // PolygonSprite(shape=rectGoalBottom, color=#00ff00, layer=layer+3)
        PolygonCollider<TableBorderBottomRight>(shape=rectBottomRight, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectBottomRight, color=#00ff00, layer=layer)
    
    } else {    
        PolygonCollider<TableBorderTop>(shape=rectTop, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectTop, color=#00ff00, layer=layer)
        PolygonCollider<TableBorderBottom>(shape=rectBottom, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectBottom, color=#00ff00, layer=layer)
    }

    PolygonCollider<TableCornerBottomLeft>(shape=cornerBottomLeft, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=cornerBottomLeft, color=#00ff00)
    PolygonCollider<TableCornerBottomRight>(shape=cornerBottomRight, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=cornerBottomRight, color=#00ff00)
    

    if tableOrientation == TableOrientationLandscape {    
        PolygonCollider<TableBorderLeftTop>(shape=rectLeftTop, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectLeftTop, color=#00ff00, layer=layer)
        PolygonCollider<TableGoalLeft>(shape=rectGoalLeft, isSensor=true, category=Category:Table, collideWith=Category:Puck, sense=Category:Puck)
        // PolygonSprite(shape=rectGoalLeft, color=#00ff00, layer=layer+3)
        PolygonCollider<TableBorderLeftBottom>(shape=rectLeftBottom, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectLeftBottom, color=#00ff00, layer=layer)
    
        PolygonCollider<TableBorderRightTop>(shape=rectRightTop, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectRightTop, color=#00ff00, layer=layer)
        PolygonCollider<TableGoalRight>(shape=rectGoalRight, isSensor=true, category=Category:Table, collideWith=Category:Puck, sense=Category:Puck)
        // PolygonSprite(shape=rectGoalRight, color=#00ff00, layer=layer+3)
        PolygonCollider<TableBorderRightBottom>(shape=rectRightBottom, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectRightBottom, color=#00ff00, layer=layer)
    } else {
        PolygonCollider<TableBorderLeft>(shape=rectLeft, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectLeft, color=#00ff00, layer=layer)
        PolygonCollider<TableBorderRight>(shape=rectRight, category=Category:Table, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
        // PolygonSprite(shape=rectRight, color=#00ff00, layer=layer)
    }

    // mallet barrier seperating each side
    if tableOrientation == TableOrientationLandscape {    
        PolygonCollider<TableMiddleSeparator>(shape=Line([@(0,-tableSize.Y*0.5+0.25), @(0,tableSize.Y*0.5-0.25)], radius=0.2), category=Category:Table, passthroughSiblings=true, restitution=0, collideWith=Category:Mallet, intercept=Category:Mallet)
    } else {
        PolygonCollider<TableMiddleSeparator>(shape=Line([@(-tableSize.X*0.5+0.25, 0), @(tableSize.X*0.5-0.25, 0)], radius=0.2), category=Category:Table, passthroughSiblings=true, restitution=0, collideWith=Category:Mallet, intercept=Category:Mallet)
    }
    // table design
    PolygonSprite(shape=Rectangle(width=tableSize.X-10+TABLE_BORDER_WIDTH, height=tableSize.Y-10+TABLE_BORDER_WIDTH, border=5), color=TABLE_COLOR_BORDER, layer=layer)
    PolygonSprite(shape=Rectangle(width=tableSize.X-10, height=tableSize.Y-10, border=5), color=TABLE_COLOR_SURFACE, layer=layer)
    if tableOrientation == TableOrientationLandscape {
        const rectSpriteGoalLeft = Rectangle(pos=@(-tableSize.X*0.5, 0), width=goalSize.X, height=goalSize.Y)
        GoalLeftRect = rectSpriteGoalLeft
        const rectSpriteGoalRight = Rectangle(pos=@(tableSize.X*0.5, 0), width=goalSize.X, height=goalSize.Y)
        GoalRightRect = rectSpriteGoalRight
        // PolygonSprite(shape=rectSpriteGoalLeft, color=TABLE_COLOR_GOAL, layer=layer+3)
        // PolygonSprite(shape=rectSpriteGoalRight, color=TABLE_COLOR_GOAL, layer=layer+3)
    } else {
        const rectSpriteGoalTop = Rectangle(pos=@(0, -tableSize.Y*0.5), width=goalSize.X, height=goalSize.Y)
        GoalTopRect = rectSpriteGoalTop
        const rectSpriteGoalBottom = Rectangle(pos=@(0, tableSize.Y*0.5), width=goalSize.X, height=goalSize.Y)
        GoalBottomRect = rectSpriteGoalBottom
        // PolygonSprite(shape=rectSpriteGoalTop, color=TABLE_COLOR_GOAL, layer=layer+3)
        // PolygonSprite(shape=rectSpriteGoalBottom, color=TABLE_COLOR_GOAL, layer=layer+3)        
    }
    // table lines
    let line1 = Line([@(-tableSize.X*0.35,-tableSize.Y*0.5+0.35), @(-tableSize.X*0.35,tableSize.Y*0.5-0.35)], radius=0.2)
    let line2 = Line([@(0,-tableSize.Y*0.5+0.35), @(0,tableSize.Y*0.5-0.35)], radius=0.2)
    let line3 = Line([@(tableSize.X*0.35,-tableSize.Y*0.5+0.35), @(tableSize.X*0.35,tableSize.Y*0.5-0.35)], radius=0.2)
    if tableOrientation == TableOrientationPortrait {
        line1 = Line([@(-tableSize.X*0.5+0.35, -tableSize.Y*0.35), @(tableSize.X*0.5-0.35, -tableSize.Y*0.35)], radius=0.2)
        line2 = Line([@(-tableSize.X*0.5+0.35, 0), @(tableSize.X*0.5-0.35, 0)], radius=0.2)
        line3 = Line([@(-tableSize.X*0.5+0.35, tableSize.Y*0.35), @(tableSize.X*0.5-0.35, tableSize.Y*0.35)], radius=0.2)
    }
    PolygonSprite(shape=line1, color=TABLE_COLOR_LINE, layer=layer)
    PolygonSprite(shape=line2, color=TABLE_COLOR_LINE, layer=layer)
    PolygonSprite(shape=line3, color=TABLE_COLOR_LINE, layer=layer)
    PolygonSprite(shape=Circle(radius=7), color=TABLE_COLOR_LINE, layer=layer)
    PolygonSprite(shape=Circle(radius=6.6), color=TABLE_COLOR_SURFACE, layer=layer)
    PolygonSprite(shape=Circle(radius=0.5), color=TABLE_COLOR_LINE, layer=layer)

    on BeforeCollide that {
        if that.Category.Overlaps(Category:Mallet) && (PointerOutside(that.Owner) || WrongSide(that.Owner, mallet=that)) {
            ReleaseMallet
        }
    }
    
    on BeforeCollide<TableGoalTop> {
        GoalTop
    }

    on BeforeCollide<TableGoalBottom> {
        GoalBottom
    }
    
    on BeforeCollide<TableGoalLeft> {
        GoalLeft
    }

    on BeforeCollide<TableGoalRight> {
        GoalRight
    }

}

pub fn table.PointerOutside([owner]) -> Boolean {
    return Pointer.X < -Size.X*0.5 || Pointer.X > Size.X*0.5 || Pointer.Y < -Size.Y*0.5 || Pointer.Y > Size.Y*0.5
}

pub fn table.WrongSide([owner], mallet) -> Boolean {
    if Orientation == TableOrientationLandscape {
        return (mallet.HomeSide.X < 0 && Pointer.X > 0) || (mallet.HomeSide.X > 0 && Pointer.X < 0)
    } else {
        return (mallet.HomeSide.Y < 0 && Pointer.Y > 0) || (mallet.HomeSide.Y > 0 && Pointer.Y < 0)
    }
}

pub fn table.Scratched([owner], malletPos) -> Boolean {
    return malletPos.X < -Size.X*0.5 || malletPos.X > Size.X*0.5 > 0 || malletPos.Y < -Size.Y*0.5 || malletPos.Y > Size.Y*0.5 > 0 
}

pub fn table.GetGoalRect([owner], tableSide) -> Rectangle {
    if (Orientation == TableOrientationLandscape) {
        if (tableSide == TableSideNear) {
            return GoalLeftRect
        } else {
            return GoalRightRect
        }
    } else {
        if (tableSide == TableSideNear) {
            return GoalBottomRect
        } else {
            return GoalTopRect
        }
    }
}