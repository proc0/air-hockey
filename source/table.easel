pub tangible category Category:Table

const TABLE_SIZE = @(150, 75)
const TABLE_GOAL_SIZE = 0.25
const TABLE_POS = @(0, 0)
const TABLE_BORDER_WIDTH = 2
const TABLE_CORNER_WIDTH = 1
const TABLE_CORNER_CURVE = 7
const TABLE_RESTITUTION = 0.7

symbol TableCornerTopLeft
symbol TableCornerTopRight

symbol TableBorderTop

symbol TableCornerBottomLeft
symbol TableCornerBottomRight

symbol TableBorderLeftTop
symbol TableGoalLeft
symbol TableBorderLeftBottom
symbol TableBorderRightTop
symbol TableGoalRight
symbol TableBorderRightBottom
symbol TableBorderBottom

pub signal World.PointerOut
pub signal World.GoalLeft
pub signal World.GoalRight

pub fn table.Table {
    use body = table
    use layer = 2
    
    Body(pos=TABLE_POS, immovable=true)

    // PoligonPerimiter(shape=Rectangle(width=TABLE_SIZE.X, height=TABLE_SIZE.Y))
    
    const rectTop = Rectangle(pos=@(0, -TABLE_SIZE.Y*0.5-TABLE_BORDER_WIDTH*0.5), width=TABLE_SIZE.X, height=TABLE_BORDER_WIDTH)
    
    const sideSegmentSize = 0.5*TABLE_SIZE.Y*(1 - TABLE_GOAL_SIZE)
    const goalSize = TABLE_SIZE.Y*TABLE_GOAL_SIZE
    const rectLeftTop = Rectangle(pos=@(-TABLE_SIZE.X*0.5-TABLE_BORDER_WIDTH*0.5, -(goalSize+sideSegmentSize)*0.5), width=TABLE_BORDER_WIDTH, height=sideSegmentSize)
    const rectLeftBottom = Rectangle(pos=@(-TABLE_SIZE.X*0.5-TABLE_BORDER_WIDTH*0.5, (goalSize+sideSegmentSize)*0.5), width=TABLE_BORDER_WIDTH, height=sideSegmentSize)
    const rectRightTop = Rectangle(pos=@(TABLE_SIZE.X*0.5+TABLE_BORDER_WIDTH*0.5, -(goalSize+sideSegmentSize)*0.5), width=TABLE_BORDER_WIDTH, height=sideSegmentSize)
    const rectRightBottom = Rectangle(pos=@(TABLE_SIZE.X*0.5+TABLE_BORDER_WIDTH*0.5, (goalSize+sideSegmentSize)*0.5), width=TABLE_BORDER_WIDTH, height=sideSegmentSize)
    
    const rectBottom = Rectangle(pos=@(0, TABLE_SIZE.Y*0.5+TABLE_BORDER_WIDTH*0.5), width=TABLE_SIZE.X, height=TABLE_BORDER_WIDTH)

    const cornerTopLeft = Arc(arc=0.25rev, orbit=TABLE_CORNER_CURVE, pos=@(-TABLE_SIZE.X*0.5+(2*TABLE_CORNER_CURVE-TABLE_CORNER_WIDTH), -TABLE_SIZE.Y*0.5+TABLE_CORNER_CURVE-TABLE_CORNER_WIDTH), radius=TABLE_CORNER_WIDTH, angle=0.5rev)
    const cornerTopRight = Arc(arc=0.25rev, orbit=TABLE_CORNER_CURVE, pos=@(TABLE_SIZE.X*0.5+TABLE_CORNER_WIDTH, -TABLE_SIZE.Y*0.5+TABLE_CORNER_CURVE-TABLE_CORNER_WIDTH), radius=TABLE_CORNER_WIDTH, angle=0.75rev)
    const cornerBottomLeft = Arc(arc=0.25rev, orbit=TABLE_CORNER_CURVE, pos=@(-TABLE_SIZE.X*0.5+(2*TABLE_CORNER_CURVE-TABLE_CORNER_WIDTH), TABLE_SIZE.Y*0.5-TABLE_CORNER_CURVE+TABLE_CORNER_WIDTH), radius=TABLE_CORNER_WIDTH, angle=0.25rev)
    const cornerBottomRight = Arc(arc=0.25rev, orbit=TABLE_CORNER_CURVE, pos=@(TABLE_SIZE.X*0.5+TABLE_CORNER_WIDTH, TABLE_SIZE.Y*0.5-TABLE_CORNER_CURVE+TABLE_CORNER_WIDTH), radius=TABLE_CORNER_WIDTH, angle=0rev)
   
    
    PolygonCollider<TableCornerTopLeft>(shape=cornerTopLeft, category=Category:Table, density=5, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=cornerTopLeft, color=#00ff00)
    
    PolygonCollider<TableCornerTopRight>(shape=cornerTopRight, category=Category:Table, density=5, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=cornerTopRight, color=#00ff00)


    
    PolygonCollider<TableBorderTop>(shape=rectTop, category=Category:Table, density=5, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=rectTop, color=#00ff00, layer=layer)

    

    PolygonCollider<TableCornerBottomLeft>(shape=cornerBottomLeft, category=Category:Table, density=5, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=cornerBottomLeft, color=#00ff00)
    
    PolygonCollider<TableCornerBottomRight>(shape=cornerBottomRight, category=Category:Table, density=5, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=cornerBottomRight, color=#00ff00)
    

    PolygonCollider<TableBorderLeftTop>(shape=rectLeftTop, category=Category:Table, density=5, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=rectLeftTop, color=#00ff00, layer=layer)
    PolygonCollider<TableBorderLeftBottom>(shape=rectLeftBottom, category=Category:Table, density=5, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=rectLeftBottom, color=#00ff00, layer=layer)

    PolygonCollider<TableBorderRightTop>(shape=rectRightTop, category=Category:Table, density=5, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=rectRightTop, color=#00ff00, layer=layer)
    PolygonCollider<TableBorderRightBottom>(shape=rectRightBottom, category=Category:Table, density=5, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=rectRightBottom, color=#00ff00, layer=layer)


    
    PolygonCollider<TableBorderBottom>(shape=rectBottom, category=Category:Table, density=5, passthroughSiblings=true, restitution=TABLE_RESTITUTION)
    // PolygonSprite(shape=rectBottom, color=#00ff00, layer=layer)


    
    PolygonSprite(shape=Rectangle(width=TABLE_SIZE.X-8, height=TABLE_SIZE.Y-8, border=5), color=#0000ff, layer=layer)
    PolygonSprite(shape=Rectangle(width=TABLE_SIZE.X-10, height=TABLE_SIZE.Y-10, border=5), color=#bebebe, layer=layer)

    const goalSensorOffset = 1
    PolygonCollider<TableGoalLeft>(shape=Rectangle(pos=@(-TABLE_SIZE.X*0.5-goalSensorOffset, 0), width=5, height=goalSize), isSensor=true, category=Category:Table, collideWith=Category:Puck, sense=Category:Puck)
    PolygonSprite(shape=Rectangle(pos=@(-TABLE_SIZE.X*0.5-goalSensorOffset, 0), width=5, height=goalSize), color=#00ff00, layer=layer+3)
    
    PolygonCollider<TableGoalRight>(shape=Rectangle(pos=@(TABLE_SIZE.X*0.5+goalSensorOffset, 0), width=5, height=goalSize), isSensor=true, category=Category:Table, collideWith=Category:Puck, sense=Category:Puck)
    PolygonSprite(shape=Rectangle(pos=@(TABLE_SIZE.X*0.5+goalSensorOffset, 0), width=5, height=goalSize), color=#00ff00, layer=layer+3)
    
    PolygonSprite(shape=Line([@(-TABLE_SIZE.X*0.25,-TABLE_SIZE.Y*0.5+0.25), @(-TABLE_SIZE.X*0.25,TABLE_SIZE.Y*0.5-0.25)], radius=0.2), color=#888888, layer=layer)
    PolygonSprite(shape=Line([@(0,-TABLE_SIZE.Y*0.5+0.25), @(0,TABLE_SIZE.Y*0.5-0.25)], radius=0.2), color=#888888, layer=layer)
    PolygonSprite(shape=Line([@(TABLE_SIZE.X*0.25,-TABLE_SIZE.Y*0.5+0.25), @(TABLE_SIZE.X*0.25,TABLE_SIZE.Y*0.5-0.25)], radius=0.2), color=#888888, layer=layer)
    PolygonSprite(shape=Circle(radius=7), color=#888888, layer=layer)
    PolygonSprite(shape=Circle(radius=6.6), color=#bebebe, layer=layer)
    PolygonSprite(shape=Circle(radius=0.5), color=#888888, layer=layer)


    
    on BeforeCollide that {
        if that.Category.Overlaps(Category:Mallet) && PointerOutside(that.Owner) {
            PointerOut
        }
    }

    on AfterCollide<TableGoalLeft> that {
        that.Despawn
        GoalLeft
    }

    on AfterCollide<TableGoalRight> that {
        that.Despawn
        GoalRight
    }
}

fn table.PointerOutside([owner]) -> Boolean {
    return Pointer.X < -TABLE_SIZE.X*0.5 || Pointer.X > TABLE_SIZE.X*0.5 || Pointer.Y < -TABLE_SIZE.Y*0.5 || Pointer.Y > TABLE_SIZE.Y*0.5
}
