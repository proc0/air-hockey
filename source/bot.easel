pub fn UpdateIntercept(ownGoalPos, mallet, puck) {
    const puckToGoal = ownGoalPos - puck.Pos
    const halfPuckToGoal = puckToGoal*0.5

    mallet.Velocity = mallet.Velocity.Towards(halfPuckToGoal*BOT_ACCELERATION, BOT_URGENCY)

    if !IsPuckVeryCloseToGoal(ownGoalPos, puck=puck) {
        if IsPuckThreateningGoal(ownGoalPos, puck=puck) {
            mallet.BotState = BotStateDEFEND
        } else {
            mallet.BotState = BotStateIDLE
        }
    } else {
        mallet.BotState = BotStateINTERCEPT
    }
    
}