pub tangible category Category:Mallet

const MALLET_RADIUS = 5
const MALLET_RESTITUTION = 0.9

pub prop mallet.HomeSide
pub prop mallet.BotState

pub signal World.MalletGrabAttempt
pub signal World.MalletGrab
pub signal World.MalletRelease

pub fn mallet.Mallet([owner], radius=MALLET_RADIUS, side, pos=Pointer) {
    use body = mallet
    use radius=radius
    use pos=pos
    use color=#000000
    use layer = 4

    HomeSide=side

    Body(gravityScale=0)
    PolygonCollider(shape=Circle, category=Category:Mallet, restitution=MALLET_RESTITUTION, intercept=Category:Puck, tolerance=0.1)
    
    PolygonSprite(shape=Circle(radius=radius*1.03))
    PolygonSprite(shape=Circle, ownerColor=1)
    PolygonSprite(shape=Circle(radius=radius*0.83))
    PolygonSprite(shape=Circle(radius=radius*0.8), ownerColor=0.8)
    PolygonSprite(shape=Circle(radius=radius*0.43))
    PolygonSprite(shape=Circle(radius=radius*0.4), ownerColor=1)
    PolygonSprite(shape=Circle(pos=@(-1,-1), radius=radius*0.1), color=#ffffff)

    on Paint {
        Streak(dissipate=0.2s, bloom=0.6, diminish=0.9, taper=0.8, fade=0.8, opacity=0.5, radius=3, ownerColor=0.5, bloomAlpha=0.2, glare=0.3, color=#bbbbbb, layer=layer-1)
    }
    
    let grabbing = false
    
    with Pointer {
        behavior on BeforePhysics {
            if grabbing {
                Velocity = (Pointer - Pos)*30
            }
        }
    }

    if !owner.IsHuman {
        BotState = BotStateGUARD
    }
    
    if owner.IsHuman {
        
        on ButtonDown(Click) {
            MalletGrabAttempt
        }
    
        on ButtonDown(SecondaryClick) {
            grabbing = false
            MalletRelease
        }
    
        on GrabMallet {
            grabbing = true
            MalletGrab
        }
        
        on ReleaseMallet {
            grabbing = false
            MalletRelease
            Velocity *= 0.3
        }
    }
}

