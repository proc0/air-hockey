pub tangible category Category:Mallet

const MALLET_RESTITUTION = 0.9
const MALLET_RADIUS = 5

pub signal World.MalletGrab
pub signal World.MalletRelease

pub fn mallet.Mallet([owner]) {
    use body = mallet
    use layer = 4
    
    Body(pos=Pointer, gravityScale=0)
    PolygonCollider(shape=Circle(radius=MALLET_RADIUS), category=Category:Mallet, restitution=MALLET_RESTITUTION, intercept=Category:Puck, tolerance=0.1)
    PolygonSprite(shape=Circle(radius=MALLET_RADIUS), color=#bb0000, layer=layer)
    PolygonSprite(shape=Circle(radius=MALLET_RADIUS*0.8), color=#ff0000, layer=layer)
    PolygonSprite(shape=Circle(radius=MALLET_RADIUS*0.4), color=#bb0000, layer=layer)

    let grabbing = false
    
    with Pointer {
        behavior on BeforePhysics {
            if grabbing {
                Velocity = (Pointer - Pos)*30
            }
        }
    }

    on ButtonDown(Click) {
        grabbing = true
        MalletGrab
    }

    on ButtonDown(SecondaryClick) {
        grabbing = false
        MalletRelease
    }


    on PointerOut {
        grabbing = false
        MalletRelease
        Velocity *= 0.3
    }
}
